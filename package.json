{
  "name": "@zsrobinson/mc",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "start": "tsx server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint panel vite.config.ts",
    "format": "prettier --write panel vite.config.ts eslint.config.js tsconfig.json",
    "format:check": "prettier --check panel vite.config.ts eslint.config.js tsconfig.json",
    "shell:update": "node scripts/shell-update.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/router-plugin": "^1.169.0",
    "@zip.js/zip.js": "^2.25.0",
    "@zsrobinson/shell": "git+https://github.com/zsrobinson/shell.git#a8e04fe69f2b3b929a084acf77d574cf9e3578c8",
    "hono": "^4.10.0",
    "jose": "^6.1.0",
    "lucide-react": "^1.77.0",
    "nbtify": "^2.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "tar": "^7.5.23",
    "tar-stream": "^3.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/tar-stream": "^3.1.5",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.2.0"
  }
}
